{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.0/manifest",
  "title": "A snapshot's manifest, written last: its presence means the snapshot is complete",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "exporttime", "producer", "window", "timezone", "files", "complete"],
  "properties": {
    "contract": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "exporttime": {"$ref": "#/$defs/time"},
    "producer": {"type": "string", "minLength": 1, "maxLength": 80},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/time"}, "to": {"$ref": "#/$defs/time"}}
    },
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$", "maxLength": 64},
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]{1,80}\\.jsonl$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "counts"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "counts": {"type": "object", "propertyNames": {"pattern": "^onloop\\.[a-z_.]+$"}, "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "complete": {"type": "object", "propertyNames": {"pattern": "^onloop\\.[a-z_.]+$"}, "additionalProperties": {"type": "boolean"}}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}
  }
}
