{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.0/turn.ended",
  "title": "A role's turn ended. Of the message, only its outcome line, if it has one",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "session_id", "prompt_id"],
  "properties": {
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "session_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "prompt_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "outcome_line": {"type": "string", "pattern": "^outcome:", "maxLength": 400},
    "parse_error": {"type": "string", "maxLength": 200}
  }
}
