{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.1/pr.checks",
  "title": "One completed check run on a pull request's head: its name and conclusion, never its log",
  "type": "object",
  "additionalProperties": false,
  "required": ["number", "head_sha", "check", "conclusion", "started_at", "completed_at"],
  "properties": {
    "number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "check": {"type": "string", "minLength": 1, "maxLength": 80},
    "conclusion": {"enum": ["success", "failure", "cancelled", "skipped", "timed_out", "neutral", "action_required"]},
    "started_at": {"$ref": "#/$defs/time"},
    "completed_at": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}
  }
}
