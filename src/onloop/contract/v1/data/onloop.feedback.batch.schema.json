{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.0/feedback.batch",
  "title": "A batch of feedback the person gave in one sitting, with the stages the team moves each item through",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch", "stages", "items"],
  "properties": {
    "batch": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "from": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "stages": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "items": {"type": "integer", "minimum": 0}
  }
}
