{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.1/wait.cleared",
  "title": "A wait ended: it names the wait it clears by the same on, waits_on and since",
  "type": "object",
  "additionalProperties": false,
  "required": ["on", "waits_on", "since", "cleared_at"],
  "properties": {
    "on": {"type": "string", "pattern": "^pr:[1-9][0-9]{0,8}$"},
    "waits_on": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "since": {"$ref": "#/$defs/time"},
    "cleared_at": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}
  }
}
