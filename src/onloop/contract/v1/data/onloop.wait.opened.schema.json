{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "onloop-contract/1.1/wait.opened",
  "title": "A pull request began to wait on a role, the person or the team. It stays open until a wait.cleared names it",
  "type": "object",
  "additionalProperties": false,
  "required": ["on", "waits_on", "since"],
  "properties": {
    "on": {"type": "string", "pattern": "^pr:[1-9][0-9]{0,8}$"},
    "waits_on": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "waits_for": {"enum": ["approve", "walk", "verdict", "rebase", "deploy-go", "other"]},
    "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"}
  }
}
