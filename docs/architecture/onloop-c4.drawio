<mxCell id="c2" value="&lt;b&gt;[Deployment] onloop · the project lead's Windows 11 workstation&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="2020" height="34" as="geometry"/></mxCell>
<mxCell id="c3" value="Where each part runs, who starts it and what was measured on this host (resident-service and session-primitives spikes, 2026-11-05 and 2026-11-09). Ports are on the loopback address unless marked." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1980" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;table style="font-size:10.5px"&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;C4 view&lt;/td&gt;&lt;td&gt;&lt;b&gt;Deployment · one workstation&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;System&lt;/td&gt;&lt;td&gt;&lt;b&gt;onloop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Version&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3.0a1 (onloop.__version__)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Model as of&lt;/td&gt;&lt;td&gt;&lt;b&gt;2026-11-09&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Page&lt;/td&gt;&lt;td&gt;&lt;b&gt;5 of 7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F7F7;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2100" y="20" width="400" height="108" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#BFBFBF;strokeWidth=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="138" as="sourcePoint"/><mxPoint x="2500" y="138" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c6" value='&lt;b style="font-size:13px"&gt;Windows 11 workstation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: Windows 11 Pro 10.0.26200, desktop, no battery]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;One machine, one OS user. Every listener binds the loopback address; nothing is installed machine-wide.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#333333"&gt;onloop listens on: onloopd 8790 (the API and the UI) · Healthchecks 8000&lt;br&gt;Reserved by another program on this host, never bind: 8765 · 8766 · 8767 · 8443&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FCFCFC;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="1960" height="1660" as="geometry"/></mxCell>
<mxCell id="c7" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1948.5" y="151" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c8" value='&lt;b style="font-size:13px"&gt;Interactive user session&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: One OS user, Medium integrity, not an administrator]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Every onloop process runs as this user; the tasks use its logon token, so they run while it is logged on.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="1910" height="1060" as="geometry"/></mxCell>
<mxCell id="c9" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1928.5" y="281" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c10" value='&lt;b style="font-size:13px"&gt;Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: Windows Task Scheduler, InteractiveToken, Limited]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Two tasks for the current user, registered without elevation.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="360" height="560" as="geometry"/></mxCell>
<mxCell id="c11" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="395.9" y="391" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Deployment Node: Edge or Chrome]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;The project lead's own browser on the same machine.&lt;/span&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="100" y="1000" width="360" height="320" as="geometry"/></mxCell>
<mxCell id="c13" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="408.5" y="991" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c14" value='&lt;b style="font-size:13px"&gt;pythonw.exe&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: Python 3.12.10, no console window]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Owner, the logged-on user.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="370" height="300" as="geometry"/></mxCell>
<mxCell id="c15" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c16" value='&lt;b style="font-size:13px"&gt;State folder&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: NTFS folder, .onloop/]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Beside the ledger, onloopd writes onloopd.pid, onloopd.heartbeat.json (every tick), onloopd.token and onloopd.stop.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=bottom;spacingBottom=8;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="520" y="740" width="370" height="340" as="geometry"/></mxCell>
<mxCell id="c17" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.5" y="731" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c18" value='&lt;b style="font-size:13px"&gt;Claude Code CLI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: npm, claude.cmd 2.1.223]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;One process per wake (R4).&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="720" height="580" as="geometry"/></mxCell>
<mxCell id="c19" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1628.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b style=&quot;font-size:13px&quot;&gt;Team's job runner&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Deployment Node: Any scheduler on the host]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px&quot;&gt;Runs the team's scheduled jobs.&lt;/span&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1720" y="440" width="240" height="330" as="geometry"/></mxCell>
<mxCell id="c21" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1908.5" y="431" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c22" value='&lt;b style="font-size:13px"&gt;WSL2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: WSL 2.7.8, kernel 6.18, NAT mode]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Distros Ubuntu-24.04 and docker-desktop.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#F5F5F5;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="520" y="1390" width="1450" height="400" as="geometry"/></mxCell>
<mxCell id="c23" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1918.5" y="1381" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c24" value='&lt;b style="font-size:13px"&gt;Docker Desktop&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: Docker engine 29.8.0, started at logon]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;Shared with other containers; onloop touches only its own container by name and never restarts Docker Desktop.&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="550" y="1470" width="1390" height="300" as="geometry"/></mxCell>
<mxCell id="c25" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1888.5" y="1461" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c26" value='&lt;b style="font-size:13px"&gt;healthchecks container&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Deployment Node: healthchecks/healthchecks:v5.0.3 (sha256:5eb96eb7…479c)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10.5px"&gt;About 229 MiB RAM, 0.02 % CPU idle.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#333333"&gt;-p 127.0.0.1:8000:8000 · named volume (SQLite)&lt;br&gt;--restart unless-stopped (the default, no, does not survive a reboot)&lt;br&gt;REGISTRATION_OPEN=False · INTEGRATIONS_ALLOW_PRIVATE_IPS=True&lt;/span&gt;' style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;fillColor=#FAFAFA;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=0;overflow=visible;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="580" y="1550" width="1330" height="200" as="geometry"/></mxCell><!-- scan:allow -->
