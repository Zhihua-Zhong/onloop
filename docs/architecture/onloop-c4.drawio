<mxCell id="c28" value='Starts it;&lt;br&gt;skips while&lt;br&gt;one runs&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[pythonw.exe, IgnoreNew]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c70" target="c76"><mxGeometry x="-0.05" relative="1" as="geometry"></mxGeometry></mxCell>
