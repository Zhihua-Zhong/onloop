<mxCell id="c2" value="&lt;b&gt;[Container] onloop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1880" height="34" as="geometry"/></mxCell>
<mxCell id="c3" value="The deployable and runnable parts of onloop and the adopted products it runs with. onloopd is the only process onloop owns; everything reaches it on the loopback address." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1840" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;table style="font-size:10.5px"&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;C4 view&lt;/td&gt;&lt;td&gt;&lt;b&gt;Level 2 · Container&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;System&lt;/td&gt;&lt;td&gt;&lt;b&gt;onloop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Version&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3.0a1 (onloop.__version__)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Model as of&lt;/td&gt;&lt;td&gt;&lt;b&gt;2026-11-09&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Page&lt;/td&gt;&lt;td&gt;&lt;b&gt;2 of 7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F7F7;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1960" y="20" width="400" height="108" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#BFBFBF;strokeWidth=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="138" as="sourcePoint"/><mxPoint x="2360" y="138" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c6" value='&lt;b style="font-size:13px"&gt;onloop&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Software System: Python 3.12, SQLite, Claude Code CLI]&lt;/span&gt;' style="rounded=1;arcSize=1;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#333333;fillColor=none;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=10 5;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;container=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="1540" height="930" as="geometry"/></mxCell>
<mxCell id="c7" value='Reads the constraint and what&lt;br&gt;waits on them; copies commands&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP, localhost]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c57" target="c59"><mxGeometry x="0.74" relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="320"/></Array></mxGeometry></mxCell>
<mxCell id="c8" value='Approves with a PIN&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[WebAuthn, Windows Hello]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c57" target="c61"><mxGeometry x="0.74" relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="320"/></Array></mxGeometry></mxCell>
<mxCell id="c9" value='Reads the read models; follows the&lt;br&gt;event stream&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[GET /api/*, SSE]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.55;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.21;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c59" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value='Posts the signed decision&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP POST, WebAuthn assertion]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=0.25;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.94;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c61" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value='Reads onloopd.yaml, onloop.yaml at&lt;br&gt;start&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[YAML, fail closed]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.11;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c65" target="c55"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="650"/><mxPoint x="820" y="650"/><mxPoint x="820" y="255"/></Array></mxGeometry></mxCell>
<mxCell id="c12" value='Starts; reruns&lt;br&gt;it if hung&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[pythonw.exe, schtasks /End /Run]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.44;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.145;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c63" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value='Watchdog ping every 5 min&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP GET /ping/&amp;lt;uuid&amp;gt;]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c63" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value='Ping /start, /0, /fail&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP, curl]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.28;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c77" target="c69"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="940"/></Array></mxGeometry></mxCell>
<mxCell id="c15" value='Webhook on&lt;br&gt;down and up&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[POST /sources/healthchecks]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.05;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.95;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c69" target="c65"><mxGeometry x="0.19" relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="1050"/><mxPoint x="900" y="890"/></Array><mxPoint x="-52" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="c16" value='Dead-man ping&lt;br&gt;every 60 s&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP GET]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=0;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c65" target="c69"><mxGeometry x="0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="742" y="860"/></Array></mxGeometry></mxCell>
<mxCell id="c17" value='Dead-man alert&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[E-mail or push integration]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=0;exitY=0.6;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.29;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c69" target="c79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c18" value='Appends events; reads projections&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[sqlite3, WAL]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.1;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.27;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c65" target="c71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c19" value='Starts one turn&lt;br&gt;under the lease&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[subprocess, stream-json]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c65" target="c67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c20" value='Reads PRs&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[gh api, ETag, every 1 min]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.08;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c65" target="c81"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="716"/><mxPoint x="1480" y="660"/><mxPoint x="2190" y="660"/></Array></mxGeometry></mxCell>
<mxCell id="c21" value='Pushes; opens&lt;br&gt;and reviews&lt;br&gt;PRs&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[git, gh]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.375;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c67" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c22" value='Inference&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTPS, subscription]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c67" target="c83"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2000" y="870"/><mxPoint x="2000" y="1080"/></Array></mxGeometry></mxCell>
<mxCell id="c23" value='Runs on Stop&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[hook JSON on stdin]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.73;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c67" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c24" value='Appends the turn&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[JSONL]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.8;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c67" target="c75"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c25" value='Posts the hook payload&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[POST /hooks/*, Bearer token]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.1;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.89;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c73" target="c65"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1483" y="960"/><mxPoint x="1350" y="960"/></Array></mxGeometry></mxCell>
<mxCell id="c55" value='&lt;b style="font-size:13px"&gt;Team config repository&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Git repository, YAML, Python plugins]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;onloop.yaml (roles, resources, policy), onloopd.yaml (schedules, monitors, GitHub) and plugins such as the gate checks.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="c56" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="288.5" y="161" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#08427B;strokeColor=#073B6F;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=mxgraph.c4.person2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1105" y="140" width="260" height="240" as="geometry"/></mxCell>
<mxCell id="c58" value='&lt;b style="font-size:13px"&gt;Project lead&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Person: Human, in a browser on the workstation]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Sets goals, reads what is stuck, answers typed asks and approves one-way doors with a passkey.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1105" y="236" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="c59" value='&lt;b style="font-size:13px"&gt;onloop UI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: React 18, React Flow + ELK, built by Vite; in the browser]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Now, Flow, Team, Conversation, Schedules and Audit over the ledger API. Read-only but for one write, a message to a role (evidence, not authority); any other action is shown as the command to copy. Served by onloopd (decision 0009).&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;http://localhost:8790&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c60" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1128.5" y="431" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c61" value='&lt;b style="font-size:13px"&gt;Approval page&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: WebAuthn passkey, Windows Hello]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Signs one decision, bound to a head SHA or a scope hash. Spike passed; not built.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;http://localhost:8790 (an IP literal cannot be a WebAuthn RP id)&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="440" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c62" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1535.9" y="431" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c63" value='&lt;b style="font-size:13px"&gt;Windows Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Windows 11 tasks, current user, no admin]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Starts onloopd at logon and every 1 min (an instance already running is skipped). A 5-min watchdog task ends and reruns a hung onloopd.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;respawn 43–53 s · hang recovery 114 s&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="650" width="320" height="180" as="geometry"/></mxCell>
<mxCell id="c64" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="725.9" y="641" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c65" value="&lt;b style=&quot;font-size:13px&quot;&gt;onloopd&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Python 3.12, stdlib HTTP server]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The resident service. Ticks every 10 s: ingests GitHub, probes wakers, runs the detectors, writes its heartbeat. Serves the UI, read-only JSON and SSE; takes writes only on /hooks, /sources and /messages with a token, and the page's message on /ui/messages with its session cookie and CSRF token.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;127.0.0.1:8790 · REST + SSE · tick 10 s · GitHub every 1 min&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="700" width="450" height="200" as="geometry"/></mxCell><!-- scan:allow -->
<mxCell id="c66" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1348.5" y="691" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c67" value="&lt;b style=&quot;font-size:13px&quot;&gt;claude -p --resume&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Claude Code CLI 2.1.223, headless]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One process per wake, under onloop's lease. stream-json in and out; --tools and --allowedTools; the result line carries is_error and permission_denials.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;environment scrubbed of CLAUDE* and ANTHROPIC*&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="700" width="340" height="200" as="geometry"/></mxCell>
<mxCell id="c68" value="PLANNED · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1804.4" y="691" width="85.6" height="18" as="geometry"/></mxCell>
<mxCell id="c69" value="&lt;b style=&quot;font-size:13px&quot;&gt;Healthchecks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Healthchecks v5.0.3, Docker in WSL2]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Expects each schedule's pings; goes down at period plus grace and posts a webhook to onloopd and the off-machine channel.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;127.0.0.1:8000 · deadline to webhook 1–3 s&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="1040" width="320" height="200" as="geometry"/></mxCell><!-- scan:allow -->
<mxCell id="c70" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="725.9" y="1031" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c71" value='&lt;b style="font-size:13px"&gt;ledger.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: SQLite, WAL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Append-only event log and its projections: items, waits, resources, leases, roles, deliveries, schedules, turns. Replay rebuilds them byte for byte.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;.onloop/ledger.db · schema v6&lt;br&gt;sources incl. config, gate, carrier, cli · wait reasons incl. blocked, handoff&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="1050" width="240" height="230" as="geometry"/></mxCell>
<mxCell id="c72" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1118.5" y="1041" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c73" value='&lt;b style="font-size:13px"&gt;Per-role hooks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Claude Code --settings, onloop daemon hook]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Stop, SessionStart and Notification hooks post their payload to onloopd and never fail the session.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;exits 0 within 2 s&lt;br&gt;whatever happens&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="1020" width="230" height="200" as="geometry"/></mxCell>
<mxCell id="c74" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1638.5" y="1011" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c75" value='&lt;b style="font-size:13px"&gt;Transcripts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: JSONL, one file per session id]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Written by Claude Code; a resume appends. onloop keeps no message text.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1720" y="1020" width="220" height="170" as="geometry"/></mxCell>
<mxCell id="c76" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1888.5" y="1011" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c77" value="&lt;b style=&quot;font-size:13px&quot;&gt;Team's scheduled jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: Any scheduler, curl]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Nightly checks, rebuilds and backups. Each run pings its start, success or failure with its log tail.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c78" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="288.5" y="851" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c79" value="&lt;b style=&quot;font-size:13px&quot;&gt;Off-machine notification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: E-mail, push or chat: the team's choice]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Receives the dead-man alert when onloopd and its watchdog are both gone. Never routed through onloopd.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="c80" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="275.9" y="1101" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c81" value='&lt;b style="font-size:13px"&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Software System: SaaS, REST API]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Repositories, pull requests, reviews, checks and rulesets: the record of the work.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2050" y="700" width="280" height="160" as="geometry"/></mxCell>
<mxCell id="c82" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2278.5" y="691" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c83" value='&lt;b style="font-size:13px"&gt;Anthropic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Software System: Claude subscription, reached only through the Claude Code CLI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Model inference for every role turn. Subscription login; no API key is ever set.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2050" y="1000" width="280" height="170" as="geometry"/></mxCell>
