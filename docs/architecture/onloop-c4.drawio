<diagram id="l2-container" name="L2 Container">
<mxGraphModel dx="2400" dy="1420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1420" math="0" shadow="0" background="#FFFFFF">
<root>
