<mxCell id="c70" value='&lt;b style="font-size:13px"&gt;onloopd task&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Infrastructure Node: Triggers at logon + every 1 min]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;MultipleInstances IgnoreNew, ExecutionTimeLimit PT0S, StartWhenAvailable, battery flags off.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;respawn after an exit 43.0 / 48.9 / 52.9 s · after a kill 52.6 s&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="125" y="500" width="310" height="200" as="geometry"/></mxCell>
<mxCell id="c71" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="370.9" y="491" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c72" value='&lt;b style="font-size:13px"&gt;Watchdog task&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Infrastructure Node: Trigger every 5 min]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Heartbeat older than 30 s → schtasks /End + /Run, then pings /fail with the reason.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;hang to new pid heartbeating 114 s · bound 5.5 min&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="125" y="730" width="310" height="200" as="geometry"/></mxCell>
<mxCell id="c73" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="370.9" y="721" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c74" value="&lt;b style=&quot;font-size:13px&quot;&gt;onloop UI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: React 18, from the wheel's package data]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Served from http://localhost:8790. The approval page (planned) adds passkey prompts from Windows Hello.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="125" y="1100" width="310" height="190" as="geometry"/></mxCell>
<mxCell id="c75" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="383.5" y="1091" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c76" value='&lt;b style="font-size:13px"&gt;onloopd&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Python 3.12]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;The resident service; one instance at a time.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;127.0.0.1:8790 · tick 10 s · stop by pid&lt;br&gt;Host must be 127.0.0.1:8790 or localhost:8790&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="480" width="320" height="190" as="geometry"/></mxCell><!-- scan:allow -->
<mxCell id="c77" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="813.5" y="471" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c78" value="&lt;b style=&quot;font-size:13px&quot;&gt;ledger.db&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: SQLite, WAL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The overlay ledger; onloop's one record, and the only one onloopd serves.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="770" width="165" height="200" as="geometry"/></mxCell>
