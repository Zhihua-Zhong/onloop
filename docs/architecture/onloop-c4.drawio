<mxCell id="c3" value="Who uses onloop and what it depends on. One Windows workstation; every listener on the loopback address; the Claude subscription is reached only through the Claude Code CLI." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1140" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;table style="font-size:10.5px"&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;C4 view&lt;/td&gt;&lt;td&gt;&lt;b&gt;Level 1 · System Context&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;System&lt;/td&gt;&lt;td&gt;&lt;b&gt;onloop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Version&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3.0a1 (onloop.__version__)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Model as of&lt;/td&gt;&lt;td&gt;&lt;b&gt;2026-11-09&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Page&lt;/td&gt;&lt;td&gt;&lt;b&gt;1 of 7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F7F7;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="20" width="400" height="108" as="geometry"/></mxCell>
