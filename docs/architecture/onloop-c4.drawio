<mxCell id="c34" value='Applies each event&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[same transaction]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.2158;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c131" target="c135"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c35" value='Opens and migrates&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.3945;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c131" target="c137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
