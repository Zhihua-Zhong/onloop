<mxCell id="c6" value='Reads what is stuck, what waits on&lt;br&gt;them and what stalled&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Browser, http://localhost:8790]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c34" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value='Wakes a role with a delivery; one&lt;br&gt;lease per session id&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[claude -p --resume, stream-json]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.28;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.28;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c40" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value="Report each turn's end and its&lt;br&gt;outcome line&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666666&quot;&gt;[Claude Code hooks, HTTP POST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.74;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.74;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value='Model inference for every turn&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTPS, subscription login]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value='Push branches; open and review&lt;br&gt;pull requests&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[git, gh]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.94;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="639"/><mxPoint x="540" y="870"/></Array></mxGeometry></mxCell>
<mxCell id="c11" value='Reads pull requests&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[REST via gh, GETs only, every 1 min]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c40" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value="Ping each run's start and result&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#666666&quot;&gt;[HTTP, Healthchecks-style pings]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value='Dead-man alert when onloopd is&lt;br&gt;gone&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Healthchecks integration]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=1;exitY=0.2;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c40" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="506"/><mxPoint x="1080" y="297"/></Array></mxGeometry></mxCell>
<mxCell id="c14" value='Alerts the project lead&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[E-mail, push or chat]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;dashed=1;dashPattern=6 4;exitX=0;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.26;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c36" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c34" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#08427B;strokeColor=#073B6F;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=mxgraph.c4.person2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="280" height="250" as="geometry"/></mxCell>
<mxCell id="c35" value='&lt;b style="font-size:13px"&gt;Project lead&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Person: Human, in a browser on the workstation]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Sets goals, reads what is stuck, answers typed asks and approves one-way doors with a passkey.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;overflow=visible;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="280" height="146" as="geometry"/></mxCell>
<mxCell id="c36" value="&lt;b style=&quot;font-size:13px&quot;&gt;Off-machine notification&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: E-mail, push or chat: the team's choice]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Receives the dead-man alert when onloopd and its watchdog are both gone. Never routed through onloopd.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="170" width="320" height="170" as="geometry"/></mxCell>
<mxCell id="c37" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1435.9" y="161" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c38" value="&lt;b style=&quot;font-size:13px&quot;&gt;The team's AI roles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: Claude Code sessions, headless]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Builder, reviewer, lead and other roles. Each is a session id that onloop resumes; every turn ends with an outcome line (decision 0007).&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="320" height="180" as="geometry"/></mxCell>
<mxCell id="c39" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="388.5" y="461" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value="&lt;b style=&quot;font-size:13px&quot;&gt;onloop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: Python 3.12, SQLite, Claude Code CLI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Human-on-the-loop overlay for a team of AI roles: turns events from the team's own tools into owned items, waits and wakes, and names the constraint.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;one Windows workstation · loopback only · subscription only&lt;br&gt;no API key&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#1168BD;strokeColor=#0B4884;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="470" width="320" height="180" as="geometry"/></mxCell>
<mxCell id="c41" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="928.5" y="461" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b style=&quot;font-size:13px&quot;&gt;Team's scheduled jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Software System: Any scheduler, curl]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Nightly checks, rebuilds and backups. Each run pings its start, success or failure with its log tail.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="470" width="320" height="180" as="geometry"/></mxCell>
<mxCell id="c43" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1448.5" y="461" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value='&lt;b style="font-size:13px"&gt;Anthropic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Software System: Claude subscription, reached only through the Claude Code CLI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Model inference for every role turn. Subscription login; no API key is ever set.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="790" width="320" height="160" as="geometry"/></mxCell>
