<mxCell id="c59" value="component owned by onloop" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1618" y="902" width="354" height="18" as="geometry"/></mxCell>
<mxCell id="c60" value="" style="html=1;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="1574" y="926" width="34" height="18" as="geometry"/></mxCell>
