<mxCell id="c37" value='Reads and writes&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[sqlite3, WAL]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.318;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c131" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c38" value='Builds the report&lt;br&gt;on request&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.05;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0462;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c97" target="c133"><mxGeometry x="0.35" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c39" value='Reads events&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.6;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.061;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c133" target="c131"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell>
<mxCell id="c83" value='&lt;b style="font-size:13px"&gt;onloop UI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: React 18, React Flow + ELK, built by Vite; in the browser]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Now, Flow, Team, Conversation, Schedules and Audit over the ledger API. Read-only but for one write, a message to a role (evidence, not authority); any other action is shown as the command to copy. Served by onloopd (decision 0009).&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;http://localhost:8790&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="c84" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="248.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c85" value='&lt;b style="font-size:13px"&gt;Per-role hooks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Claude Code --settings, onloop daemon hook]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Stop, SessionStart and Notification hooks post their payload to onloopd and never fail the session.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;exits 0 within 2 s&lt;br&gt;whatever happens&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="c86" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="248.5" y="631" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c87" value="&lt;b style=&quot;font-size:13px&quot;&gt;Healthchecks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Healthchecks v5.0.3, Docker in WSL2]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Expects each schedule's pings; goes down at period plus grace and posts a webhook to onloopd and the off-machine channel.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;127.0.0.1:8000 · deadline to webhook 1–3 s&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="260" height="170" as="geometry"/></mxCell><!-- scan:allow -->
<mxCell id="c88" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="235.9" y="871" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c89" value='&lt;b style="font-size:13px"&gt;Windows Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Windows 11 tasks, current user, no admin]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Starts onloopd at logon and every 1 min (an instance already running is skipped). A 5-min watchdog task ends and reruns a hung onloopd.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;respawn 43–53 s · hang recovery 114 s&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="c90" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1315.9" y="141" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c91" value='&lt;b style="font-size:13px"&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Software System: SaaS, REST API]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Repositories, pull requests, reviews, checks and rulesets: the record of the work.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1800" y="150" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c92" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1988.5" y="141" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c93" value="&lt;b style=&quot;font-size:13px&quot;&gt;claude -p --resume&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Claude Code CLI 2.1.223, headless]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One process per wake, under onloop's lease. stream-json in and out; --tools and --allowedTools; the result line carries is_error and permission_denials.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;environment scrubbed of CLAUDE* and ANTHROPIC*&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2490" y="960" width="260" height="200" as="geometry"/></mxCell>
<mxCell id="c94" value="PLANNED · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2654.4" y="951" width="85.6" height="18" as="geometry"/></mxCell>
<mxCell id="c95" value='&lt;b style="font-size:13px"&gt;ledger.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: SQLite, WAL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Append-only event log and its projections: items, waits, resources, leases, roles, deliveries, schedules, turns. Replay rebuilds them byte for byte.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;.onloop/ledger.db · schema v6&lt;br&gt;sources incl. config, gate, carrier, cli · wait reasons incl. blocked, handoff&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2490" y="1180" width="260" height="220" as="geometry"/></mxCell>
<mxCell id="c96" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2698.5" y="1171" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c97" value='&lt;b style="font-size:13px"&gt;HTTP surface&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: http.server, threads]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Loopback only; refuses other Hosts. GET /health and /api/items, waits, leases, constraint, turns, alerts, schedules, roles, events, report/observe; SSE on /api/stream. POST only on /hooks and /sources.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/server.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="240" height="165" as="geometry"/></mxCell>
<mxCell id="c98" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="628.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c99" value='&lt;b style="font-size:13px"&gt;UI host&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, static files, strict CSP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Serves the built UI from package data, GET only, under the same Host check, with a strict Content-Security-Policy (decision 0009). The approval page is planned.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/ui.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="240" height="172" as="geometry"/></mxCell>
<mxCell id="c100" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="968.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c101" value='&lt;b style="font-size:13px"&gt;Process and tick&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, signals, pid file]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Runs the server and the tick every 10 s: GitHub, waker probes, detectors, heartbeat. Stops cleanly on a stop file or Ctrl+C.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/main.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c102" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1308.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c103" value='&lt;b style="font-size:13px"&gt;onloopd.yaml&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: PyYAML safe_load]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Schedules, monitors and the GitHub repository to watch. Checked whole; an unknown key stops the start.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/config.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="400" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c104" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c105" value="&lt;b style=&quot;font-size:13px&quot;&gt;GitHub ingest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;[Component: Python, gh, GETs only]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Intake's polls written to the ledger directly, under the same event ids, so both paths deduplicate.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;&lt;code&gt;src/onloop/ingest/github.py&lt;/code&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1800" y="400" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c106" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1988.5" y="391" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c107" value="&lt;b style=&quot;font-size:13px&quot;&gt;Write routes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Dispatches a POST by path to its handler, under the one writer lock; every event gets the ledger's time.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;&lt;code&gt;src/onloop/daemon/routes.py&lt;/code&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="600" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c108" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="968.5" y="591" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c109" value='&lt;b style="font-size:13px"&gt;Write token&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: secrets, file ACL check]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Drawn at every start, written beside the ledger. Keeps other programs off the write routes; not a boundary against agents.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/token.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="600" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c110" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1308.5" y="591" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c111" value='&lt;b style="font-size:13px"&gt;Detector tick&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Each finding becomes one keyed alert item, opened, updated or closed; logs would.wake, escalate or restart. Acts on nothing until R4.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/detect/core.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="600" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c112" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648.5" y="591" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c113" value='&lt;b style="font-size:13px"&gt;Intake diff&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, conditional requests]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Snapshot diff of pull requests into events; a 304 costs no rate limit. Reused, not ported.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/intake.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1800" y="600" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c114" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1988.5" y="591" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c115" value='&lt;b style="font-size:13px"&gt;Hook receiver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/hooks/stop, session-start, notification. A Stop parses the outcome line and records a turn; message text is not stored.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/hook_receiver.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="800" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c116" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="968.5" y="791" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c117" value="&lt;b style=&quot;font-size:13px&quot;&gt;Missing-outcome detector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;A role's latest turn without a valid outcome line; one alert per turn.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;&lt;code&gt;src/onloop/detect/no_outcome.py&lt;/code&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="800" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c118" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1308.5" y="791" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c119" value='&lt;b style="font-size:13px"&gt;Waker probes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pid / schedule / loopback URL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Probes each waker that has an open wait: pid alive, schedule not overdue, monitor answers 2xx in 2 s. A dead one opens an alert.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/detect/wakers.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="800" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c120" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648.5" y="791" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c121" value='&lt;b style="font-size:13px"&gt;Schedule detector&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;A declared schedule whose last result failed, or with no success within period plus grace.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/detect/schedules.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1800" y="800" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c122" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1988.5" y="791" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c123" value='&lt;b style="font-size:13px"&gt;Outcome-line parser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reads the last line of a turn, outcome: &amp;lt;value&amp;gt; [key=value ...]; an error names the rule that failed.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/disposition.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1000" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c124" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="968.5" y="991" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c125" value='&lt;b style="font-size:13px"&gt;Schedule sources&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, ScheduleSource interface]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/sources/healthchecks (webhook) and /sources/schedules/&amp;lt;id&amp;gt;/ping, fail, start. An undeclared schedule is refused.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/sources.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1000" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c126" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1308.5" y="991" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c127" value="&lt;b style=&quot;font-size:13px&quot;&gt;Conductor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The carrier's loop: derives deliveries (a person's message, a handoff, the one corrective per turn, a dead waker), fires timers, escalates; observe-only (would.deliver) until a role opts in and the carrier is started.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;&lt;code&gt;src/onloop/carrier/loop.py&lt;/code&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="1000" width="240" height="140" as="geometry"/></mxCell>
<mxCell id="c128" value="BUILT · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1617" y="991" width="73" height="18" as="geometry"/></mxCell>
<mxCell id="c129" value='&lt;b style="font-size:13px"&gt;Sessions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, subprocess]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;One lease per session id (a unique index); one process and one composed message per run, in a job object; scrubs the environment, checks the login and the agents listing, counts budgets, reads each result line.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/carrier/runner.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1800" y="1000" width="240" height="175" as="geometry"/></mxCell>
<mxCell id="c130" value="BUILT · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1957" y="991" width="73" height="18" as="geometry"/></mxCell>
<mxCell id="c131" value='&lt;b style="font-size:13px"&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, sqlite3, one transaction per append]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Appends an event and applies it to the projections in one transaction; replay; reads the projections.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/overlay/ledger.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1200" width="1900" height="100" as="geometry"/></mxCell>
<mxCell id="c132" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2328.5" y="1191" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c133" value='&lt;b style="font-size:13px"&gt;Observe report&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, read-only]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;What onloop would have done next to what happened afterwards, for GET /api/report/observe.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/report/observe.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1370" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="c134" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="648.5" y="1361" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c135" value='&lt;b style="font-size:13px"&gt;Projections&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;What each event kind does to the projection tables; times come from the event, never a clock.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/overlay/projections.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1370" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="c136" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="968.5" y="1361" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c137" value='&lt;b style="font-size:13px"&gt;Schema and migrations&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: SQLite DDL, PRAGMA user_version]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;The tables and their forward-only migrations; a newer ledger is refused.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/overlay/schema.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1370" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="c138" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1308.5" y="1361" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c139" value='&lt;b style="font-size:13px"&gt;Constraint query&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Groups open waits by what they wait on, direct and downstream; the largest is the constraint.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/overlay/constraint.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="1370" width="240" height="120" as="geometry"/></mxCell>
