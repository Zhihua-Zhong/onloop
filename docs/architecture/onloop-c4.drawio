<diagram id="dynamic-dead-waker" name="Dynamic dead waker">
<mxGraphModel dx="2260" dy="1320" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1320" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c2" value="&lt;b&gt;[Dynamic] A dead waker behind a continue becomes the constraint&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1740" height="34" as="geometry"/></mxCell>
<mxCell id="c3" value="A role ends its turn with outcome: continue and names what will wake it. The waker dies. On the next tick onloopd finds it, alerts once, and the constraint query names it. Built on main." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1700" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;table style="font-size:10.5px"&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;C4 view&lt;/td&gt;&lt;td&gt;&lt;b&gt;Dynamic · built&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;System&lt;/td&gt;&lt;td&gt;&lt;b&gt;onloop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Version&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3.0a1 (onloop.__version__)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Model as of&lt;/td&gt;&lt;td&gt;&lt;b&gt;2026-11-09&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Page&lt;/td&gt;&lt;td&gt;&lt;b&gt;7 of 7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F7F7;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1820" y="20" width="400" height="108" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#BFBFBF;strokeWidth=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="138" as="sourcePoint"/><mxPoint x="2220" y="138" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c6" value='&lt;b&gt;1.&lt;/b&gt; Stop hook with the final&lt;br&gt;message&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[hook JSON on stdin]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value='&lt;b&gt;2.&lt;/b&gt; POST /hooks/stop&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP, Bearer]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c46" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value='&lt;b&gt;3.&lt;/b&gt; continue, ref=item-42, waker=pid:4242&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c48" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value='&lt;b&gt;4.&lt;/b&gt; Turn row; item-42&lt;br&gt;waits on waker&lt;br&gt;pid:4242&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value='&lt;b&gt;5.&lt;/b&gt; Next tick (≤ 10 s):&lt;br&gt;probe each waker with&lt;br&gt;an open wait&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c44" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value='&lt;b&gt;6.&lt;/b&gt; pid_alive(4242):&lt;br&gt;false&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[procs.pid_alive]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value='&lt;b&gt;7.&lt;/b&gt; resource.checked: dead (on a change&lt;br&gt;only)&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value='&lt;b&gt;8.&lt;/b&gt; Runs the detectors&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c44" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value='&lt;b&gt;9.&lt;/b&gt; One alert naming&lt;br&gt;every stranded item&lt;br&gt;and role; would.wake&lt;br&gt;logged&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c52" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" value='&lt;b&gt;10.&lt;/b&gt; Asks what holds the work up&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[GET /api/constraint]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c60" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value='&lt;b&gt;11.&lt;/b&gt; Computes over open&lt;br&gt;waits: pid:4242,&lt;br&gt;reason dead_waker&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c54" target="c58"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1880" y="721"/><mxPoint x="1880" y="948"/></Array></mxGeometry></mxCell>
<mxCell id="c38" value="&lt;b style=&quot;font-size:13px&quot;&gt;claude -p --resume&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Claude Code CLI 2.1.223, headless]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Role R's turn ends: … outcome: continue ref=item-42 waker=pid:4242&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;environment scrubbed of CLAUDE* and ANTHROPIC*&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c39" value="PLANNED · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="264.4" y="181" width="85.6" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value='&lt;b style="font-size:13px"&gt;A waker&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: A process, a schedule or a monitor URL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;pid 4242, a background build. It exits; nothing will wake R.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="c41" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="788.5" y="191" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value='&lt;b style="font-size:13px"&gt;Waker probes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pid / schedule / loopback URL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Probes each waker that has an open wait: pid alive, schedule not overdue, monitor answers 2xx in 2 s. A dead one opens an alert.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/detect/wakers.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="200" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="c43" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1268.5" y="191" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value='&lt;b style="font-size:13px"&gt;Process and tick&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, signals, pid file]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Runs the server and the tick every 10 s: GitHub, waker probes, detectors, heartbeat. Stops cleanly on a stop file or Ctrl+C.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/main.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="c45" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1748.5" y="181" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c46" value='&lt;b style="font-size:13px"&gt;Per-role hooks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Claude Code --settings, onloop daemon hook]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Stop, SessionStart and Notification hooks post their payload to onloopd and never fail the session.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;exits 0 within 2 s&lt;br&gt;whatever happens&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="c47" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="308.5" y="551" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c48" value='&lt;b style="font-size:13px"&gt;Hook receiver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/hooks/stop, session-start, notification. A Stop parses the outcome line and records a turn; message text is not stored.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/hook_receiver.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="c49" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="788.5" y="551" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c50" value='&lt;b style="font-size:13px"&gt;ledger.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: SQLite, WAL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Append-only event log and its projections: items, waits, resources, leases, roles, deliveries, schedules, turns. Replay rebuilds them byte for byte.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;.onloop/ledger.db · schema v6&lt;br&gt;sources incl. config, gate, carrier, cli · wait reasons incl. blocked, handoff&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="550" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c51" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1268.5" y="541" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value='&lt;b style="font-size:13px"&gt;Detector tick&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Each finding becomes one keyed alert item, opened, updated or closed; logs would.wake, escalate or restart. Acts on nothing until R4.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/detect/core.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="560" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="c53" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1748.5" y="551" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c54" value='&lt;b style="font-size:13px"&gt;HTTP surface&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: http.server, threads]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /api/constraint&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/server.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="560" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="c55" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2148.5" y="551" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c56" value='&lt;b style="font-size:13px"&gt;Outcome-line parser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reads the last line of a turn, outcome: &amp;lt;value&amp;gt; [key=value ...]; an error names the rule that failed.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/disposition.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="900" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c57" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="788.5" y="891" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c58" value='&lt;b style="font-size:13px"&gt;Constraint query&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Groups open waits by what they wait on, direct and downstream; the largest is the constraint.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/overlay/constraint.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="900" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c59" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1748.5" y="891" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c60" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#08427B;strokeColor=#073B6F;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=mxgraph.c4.person2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1960" y="880" width="240" height="260" as="geometry"/></mxCell>
<mxCell id="c61" value='&lt;b style="font-size:13px"&gt;Project lead&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Person: Human, in a browser on the workstation]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Sets goals, reads what is stuck, answers typed asks and approves one-way doors with a passkey.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=16;spacingRight=16;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1960" y="984" width="240" height="152" as="geometry"/></mxCell>
<mxCell id="c62" value="&lt;b&gt;Why this matters&lt;/b&gt;&lt;br&gt; A continue with a dead waker waits for ever while every role looks idle. The probe logs a state change, not every tick; the alert is one item per waker, updated as more items strand, and closed on the first tick the condition is gone. Today the would.wake is only recorded; R4 acts on it." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#1A1A1A;overflow=visible;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="420" height="120" as="geometry"/></mxCell>
