<diagram id="dynamic-wake-and-ack" name="Dynamic wake and ack">
<mxGraphModel dx="2240" dy="1180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1180" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c2" value="&lt;b&gt;[Dynamic] A wake, acknowledged by the turn it caused&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=24;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1720" height="34" as="geometry"/></mxCell>
<mxCell id="c3" value="How one delivery to a role is tracked from created to acknowledged (decision 0010). Acknowledgement is the Stop-hook turn; whether that turn wrote a valid outcome line is recorded apart." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12.5;align=left;verticalAlign=top;spacing=0;overflow=visible;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1680" height="40" as="geometry"/></mxCell>
<mxCell id="c4" value='&lt;table style="font-size:10.5px"&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;C4 view&lt;/td&gt;&lt;td&gt;&lt;b&gt;Dynamic · built (R4)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;System&lt;/td&gt;&lt;td&gt;&lt;b&gt;onloop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Version&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.3.0a1 (onloop.__version__)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Model as of&lt;/td&gt;&lt;td&gt;&lt;b&gt;2026-11-09&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="color:#666666;padding-right:10px"&gt;Page&lt;/td&gt;&lt;td&gt;&lt;b&gt;6 of 7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F7F7;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1800" y="20" width="400" height="108" as="geometry"/></mxCell>
<mxCell id="c5" value="" style="endArrow=none;html=1;strokeColor=#BFBFBF;strokeWidth=1;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="138" as="sourcePoint"/><mxPoint x="2200" y="138" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c6" value='&lt;b&gt;1.&lt;/b&gt; Delivery created; lease&lt;br&gt;taken for the session id&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c7" value='&lt;b&gt;2.&lt;/b&gt; Wake role R with&lt;br&gt;delivery D&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c38" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c8" value='&lt;b&gt;3.&lt;/b&gt; Start claude -p --resume&lt;br&gt;&amp;lt;id&amp;gt;; write the message:&lt;br&gt;delivered&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[subprocess, stream-json stdin]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.15;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c40" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c9" value='&lt;b&gt;4.&lt;/b&gt; Replays the message when&lt;br&gt;its turn starts: processing&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[--replay-user-messages]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c10" value='&lt;b&gt;5.&lt;/b&gt; Inference for the turn&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTPS, subscription]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c11" value='&lt;b&gt;6.&lt;/b&gt; One result line: is_error,&lt;br&gt;permission_denials, rate limit&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[stream-json result]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c12" value='&lt;b&gt;7.&lt;/b&gt; Stop hook with&lt;br&gt;last_assistant_message&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[hook JSON on stdin]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c42" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c13" value='&lt;b&gt;8.&lt;/b&gt; POST /hooks/stop&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[HTTP :8790, Bearer, ≤ 2 s]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c52" target="c48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c14" value='&lt;b&gt;9.&lt;/b&gt; Parses the outcome line,&lt;br&gt;valid or not&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[Python call]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c48" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c15" value='&lt;b&gt;10.&lt;/b&gt; Turn recorded; the&lt;br&gt;carrier acks D by it&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.48;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c48" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="c16" value='&lt;b&gt;11.&lt;/b&gt; Lease released&lt;br&gt;&lt;span style="font-size:9px;color:#666666"&gt;[ledger append]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#333333;strokeColor=#5E5E5E;strokeWidth=1.5;endArrow=blockThin;endFill=1;endSize=7;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=7;spacing=2;exitX=0.15;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c40" target="c46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="530"/><mxPoint x="304" y="530"/></Array></mxGeometry></mxCell>
<mxCell id="c38" value="&lt;b style=&quot;font-size:13px&quot;&gt;Conductor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The carrier's loop: derives deliveries (a person's message, a handoff, the one corrective per turn, a dead waker), fires timers, escalates; observe-only (would.deliver) until a role opts in and the carrier is started.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1A1A1A&quot;&gt;&lt;code&gt;src/onloop/carrier/loop.py&lt;/code&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="280" height="170" as="geometry"/></mxCell>
<mxCell id="c39" value="BUILT · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="277" y="181" width="73" height="18" as="geometry"/></mxCell>
<mxCell id="c40" value='&lt;b style="font-size:13px"&gt;Sessions&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, subprocess]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;One lease per session id (a unique index); one process and one composed message per run, in a job object; scrubs the environment, checks the login and the agents listing, counts budgets, reads each result line.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/carrier/runner.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="300" height="190" as="geometry"/></mxCell>
<mxCell id="c41" value="BUILT · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="817" y="181" width="73" height="18" as="geometry"/></mxCell>
<mxCell id="c42" value="&lt;b style=&quot;font-size:13px&quot;&gt;claude -p --resume&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Claude Code CLI 2.1.223, headless]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;One process per wake, under onloop's lease. stream-json in and out; --tools and --allowedTools; the result line carries is_error and permission_denials.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;environment scrubbed of CLAUDE* and ANTHROPIC*&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="190" width="320" height="200" as="geometry"/></mxCell>
<mxCell id="c43" value="PLANNED · R4" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1404.4" y="181" width="85.6" height="18" as="geometry"/></mxCell>
<mxCell id="c44" value='&lt;b style="font-size:13px"&gt;Anthropic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Software System: Claude subscription, reached only through the Claude Code CLI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Model inference for every role turn. Subscription login; no API key is ever set.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1820" y="200" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="c45" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2068.5" y="191" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c46" value='&lt;b style="font-size:13px"&gt;ledger.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: SQLite, WAL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Append-only event log and its projections: items, waits, resources, leases, roles, deliveries, schedules, turns. Replay rebuilds them byte for byte.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;.onloop/ledger.db · schema v6&lt;br&gt;sources incl. config, gate, carrier, cli · wait reasons incl. blocked, handoff&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="660" width="280" height="190" as="geometry"/></mxCell>
<mxCell id="c47" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="308.5" y="651" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c48" value='&lt;b style="font-size:13px"&gt;Hook receiver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/hooks/stop, session-start, notification. A Stop parses the outcome line and records a turn; message text is not stored.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/daemon/hook_receiver.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="650" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="c49" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="848.5" y="641" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c50" value='&lt;b style="font-size:13px"&gt;Outcome-line parser&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;[Component: Python, pure]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reads the last line of a turn, outcome: &amp;lt;value&amp;gt; [key=value ...]; an error names the rule that failed.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#1A1A1A"&gt;&lt;code&gt;src/onloop/disposition.py&lt;/code&gt;&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#85BBF0;strokeColor=#78A8D8;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="900" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="c51" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="848.5" y="891" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c52" value='&lt;b style="font-size:13px"&gt;Per-role hooks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Claude Code --settings, onloop daemon hook]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Stop, SessionStart and Notification hooks post their payload to onloopd and never fail the session.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;exits 0 within 2 s&lt;br&gt;whatever happens&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="650" width="320" height="170" as="geometry"/></mxCell>
<mxCell id="c53" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1448.5" y="641" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c54" value="&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt; &lt;b&gt;1&lt;/b&gt; The conductor creates delivery D (state &lt;i&gt;created&lt;/i&gt;) and takes the lease on R's session id. Two processes on one id fork the session silently, so the lease is mandatory; the agents listing guards against a holder outside onloop.&lt;br&gt; &lt;b&gt;2–3&lt;/b&gt; Sessions starts the CLI in a job object with a scrubbed environment and writes one composed message to stdin: &lt;i&gt;delivered&lt;/i&gt;.&lt;br&gt; &lt;b&gt;4&lt;/b&gt; The CLI replays the message when its turn starts: &lt;i&gt;processing&lt;/i&gt;, not receipt.&lt;br&gt; &lt;b&gt;6&lt;/b&gt; The one result line is read: any &lt;i&gt;permission_denials&lt;/i&gt; makes the run &lt;i&gt;refused&lt;/i&gt; (exit code 0 notwithstanding); a rate-limit rejection pauses the carrier.&lt;br&gt; &lt;b&gt;7–10&lt;/b&gt; The Stop hook's turn acknowledges D, whatever it said. A missing or invalid outcome line is recorded on the turn and starts the corrective path only for a role that opted in.&lt;br&gt; &lt;b&gt;11&lt;/b&gt; The lease is released, so the next wake may resume the session." style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#1A1A1A;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1560" y="470" width="600" height="250" as="geometry"/></mxCell>
<mxCell id="c55" value="&lt;b&gt;Key&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1560" y="840" width="420" height="242" as="geometry"/></mxCell>
<mxCell id="c56" value="" style="html=1;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#3C7FC0;" vertex="1" parent="1"><mxGeometry x="1574" y="874" width="34" height="18" as="geometry"/></mxCell>
<mxCell id="c57" value="container owned by onloop" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10.5;align=left;verticalAlign=top;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="1618" y="876" width="354" height="18" as="geometry"/></mxCell>
