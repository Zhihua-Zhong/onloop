<mxCell id="c82" value='&lt;b style="font-size:13px"&gt;Transcripts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: JSONL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;%USERPROFILE%\.claude\projects\&amp;lt;slug&amp;gt;\&amp;lt;session id&amp;gt;.jsonl&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;shape=cylinder3;size=12;boundedLbl=1;backgroundOutline=1;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="480" width="260" height="220" as="geometry"/></mxCell>
<mxCell id="c83" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1608.5" y="471" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c84" value="&lt;b style=&quot;font-size:13px&quot;&gt;onloop daemon hook&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: Python, one process per hook event]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Reads the hook's JSON on stdin, posts it with the token, exits 0 within 2 s.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="985" y="780" width="330" height="170" as="geometry"/></mxCell>
<mxCell id="c85" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1263.5" y="771" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c86" value='&lt;b style="font-size:13px"&gt;Scheduled job&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: curl]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Pings /start, then /0 or /fail; sends the tail of its log (Healthchecks keeps the first 10,000 bytes).&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#6B6B6B;strokeColor=#5A5A5A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1735" y="540" width="210" height="210" as="geometry"/></mxCell>
<mxCell id="c87" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1893.5" y="531" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c88" value='&lt;b style="font-size:13px"&gt;Healthchecks&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: Django, SQLite in a named volume]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Checks with period + grace; webhook on down; second integration for the dead-man alert.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="1575" width="630" height="160" as="geometry"/></mxCell>
<mxCell id="c89" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1815.9" y="1566" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c90" value="&lt;b style=&quot;font-size:13px&quot;&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: HTTPS 443]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;github.com, read by onloopd with GETs and written by the roles' own tools.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="290" width="420" height="130" as="geometry"/></mxCell>
<mxCell id="c91" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2428.5" y="281" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c92" value='&lt;b style="font-size:13px"&gt;Anthropic&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#E6E6E6"&gt;[Container: HTTPS 443]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Reached only by the Claude Code CLI, with the subscription login.&lt;/span&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="470" width="420" height="130" as="geometry"/></mxCell>
<mxCell id="c93" value="BUILT" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2428.5" y="461" width="41.5" height="18" as="geometry"/></mxCell>
<mxCell id="c94" value="&lt;b style=&quot;font-size:13px&quot;&gt;Off-machine channel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6E6E6&quot;&gt;[Container: SMTP, ntfy or chat]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The team's choice; outside the machine so it outlives it.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#FFFFFF;fillColor=#999999;strokeColor=#8A8A8A;dashed=1;dashPattern=8 4;strokeWidth=2;align=center;verticalAlign=middle;spacing=8;overflow=visible;rounded=1;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="690" width="420" height="130" as="geometry"/></mxCell>
<mxCell id="c95" value="PLANNED" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=9;fontStyle=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#444444;dashed=1;dashPattern=3 2;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2415.9" y="681" width="54.1" height="18" as="geometry"/></mxCell>
<mxCell id="c96" value="&lt;b&gt;Measured on this host&lt;/b&gt;&lt;br&gt; • onloopd exit(1) → respawn by the 1-min trigger: &lt;b&gt;43.0, 48.9, 52.9 s&lt;/b&gt;; kill → respawn 52.6 s&lt;br&gt; • Restart-on-failure alone never restarted an exit(1) in 240 s: the 1-min trigger is required&lt;br&gt; • Hang (alive, heartbeat stopped) → watchdog End + Run → new pid heartbeating: &lt;b&gt;114 s&lt;/b&gt;&lt;br&gt; • onloopd and watchdog both gone → dead-man webhook: &lt;b&gt;163 s&lt;/b&gt; after the kill (bound 240 s)&lt;br&gt; • Healthchecks deadline → webhook on Windows: &lt;b&gt;1.2–2.8 s&lt;/b&gt; (n = 4)&lt;br&gt; • Claude Code cold start: 0.9 s to init; 3.5–4.7 s to a one-line answer&lt;br&gt; • Not yet tested: sleep and resume, reboot, the logon trigger firing" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#1A1A1A;overflow=visible;" vertex="1" parent="1"><mxGeometry x="2060" y="880" width="420" height="215" as="geometry"/></mxCell>
<mxCell id="c97" value="&lt;b&gt;Key&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2060" y="1140" width="420" height="242" as="geometry"/></mxCell>
<mxCell id="c98" value="" style="html=1;rounded=1;arcSize=10;fillColor=#438DD5;strokeColor=#3C7FC0;" vertex="1" parent="1"><mxGeometry x="2074" y="1174" width="34" height="18" as="geometry"/></mxCell>
